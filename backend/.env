# Server Configuration
PORT=5000
NODE_ENV=development

# SST Configuration
API_KEY=sst_secret_key_12345_never_expose_in_browser

# Mock GTM Server-Side Container URL
# In production, this would be your GTM Server-Side container URL
GTM_SERVER_URL=https://jsonplaceholder.typicode.com/posts

# Google Analytics 4 Measurement Protocol (Mock)
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your_ga4_api_secret

# Facebook Conversions API (Mock)
FB_PIXEL_ID=your_pixel_id
FB_ACCESS_TOKEN=your_fb_access_token

# Data Retention (days)
DATA_RETENTION_DAYS=30

# IP Anonymization Settings
ANONYMIZE_IP=true
IP_ANONYMIZATION_MASK=2

# Consent Settings
DEFAULT_CONSENT_MODE=denied
