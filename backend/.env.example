# Server Configuration
PORT=5000
NODE_ENV=development

# SST Configuration - KEEP THIS SECRET!
API_KEY=your_secret_api_key_here

# GTM Server-Side Container URL
GTM_SERVER_URL=https://your-gtm-server.com/endpoint

# Google Analytics 4 Measurement Protocol
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your_ga4_api_secret

# Facebook Conversions API
FB_PIXEL_ID=your_pixel_id
FB_ACCESS_TOKEN=your_fb_access_token

# Data Retention (days)
DATA_RETENTION_DAYS=30

# IP Anonymization Settings
ANONYMIZE_IP=true
IP_ANONYMIZATION_MASK=2

# Consent Settings
DEFAULT_CONSENT_MODE=denied
